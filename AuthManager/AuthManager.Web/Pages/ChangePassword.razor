@page "/change-password"
@attribute [Authorize]
@using AuthManager.Web.Models
@using AuthManager.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IUserApiService UserApiService
@inject IAuthApiService AuthApiService
@inject ITokenStorageService TokenStorageService
@inject JwtAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>비밀번호 변경</PageTitle>

<h1>비밀번호 변경</h1>

<EditForm Model="request" OnValidSubmit="ChangePasswordAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">현재 비밀번호</label>
        <InputText class="form-control"
                   type="password"
                   @bind-Value="request.CurrentPassword" />
        <ValidationMessage For="@(() => request.CurrentPassword)" />
    </div>

    <div class="mb-3">
        <label class="form-label">새 비밀번호</label>
        <InputText class="form-control"
                   type="password"
                   @bind-Value="request.NewPassword" />
        <ValidationMessage For="@(() => request.NewPassword)" />
    </div>

    <div class="mb-3">
        <label class="form-label">새 비밀번호 확인</label>
        <InputText class="form-control"
                   type="password"
                   @bind-Value="request.ConfirmPassword" />
        <ValidationMessage For="@(() => request.ConfirmPassword)" />
    </div>

    <button class="btn btn-primary"
            type="submit"
            disabled="@isSubmitting">
        @(isSubmitting ? "변경 중..." : "비밀번호 변경")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success mt-3">
        @successMessage
    </div>
}

@code {
    private readonly ChangePasswordRequest request = new();
    private bool isSubmitting;
    private string errorMessage = "";
    private string successMessage = "";

    private async Task ChangePasswordAsync()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            await UserApiService.ChangePasswordAsync(request);

            successMessage =
                "비밀번호가 변경되었습니다. 다시 로그인해 주세요.";

            await LogoutAsync();
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LogoutAsync()
    {
        try
        {
            string? refreshToken =
                await TokenStorageService
                    .GetRefreshTokenAsync();

            if (!string.IsNullOrWhiteSpace(refreshToken))
            {
                await AuthApiService.LogoutAsync(
                    refreshToken);
            }
        }
        catch
        {
        }
        finally
        {
            await AuthenticationStateProvider
                .ForceLogoutAsync();

            NavigationManager.NavigateTo(
                "/login",
                replace: true);
        }
    }
}