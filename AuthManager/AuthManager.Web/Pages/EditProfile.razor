@page "/edit-profile"
@attribute [Authorize]
@using AuthManager.Web.Models
@using AuthManager.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IUserApiService UserApiService
@inject NavigationManager NavigationManager

<PageTitle>내 정보 수정</PageTitle>

<h1>내 정보 수정</h1>

@if (isLoading)
{
    <p>불러오는 중...</p>
}
else
{
    <EditForm Model="request"
              OnValidSubmit="UpdateNicknameAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">닉네임</label>

            <InputText class="form-control"
                       @bind-Value="request.Nickname" />

            <ValidationMessage For="@(() => request.Nickname)" />
        </div>

        <button class="btn btn-primary"
                type="submit"
                disabled="@isSubmitting">
            @(isSubmitting ? "수정 중..." : "닉네임 수정")
        </button>

        <button class="btn btn-secondary ms-2"
                type="button"
                @onclick="GoBack">
            취소
        </button>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success mt-3">
        @successMessage
    </div>
}

@code {
    private readonly UpdateNicknameRequest request = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            MyProfileResponse profile =
                await UserApiService.GetMyProfileAsync();

            request.Nickname = profile.Nickname;
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateNicknameAsync()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            await UserApiService.UpdateNicknameAsync(
                request);

            successMessage =
                "닉네임이 변경되었습니다.";

            await Task.Delay(700);

            NavigationManager.NavigateTo(
                "/my-profile",
                replace: true);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/my-profile");
    }
}