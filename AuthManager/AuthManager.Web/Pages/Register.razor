@page "/register"
@using AuthManager.Web.Models
@using AuthManager.Web.Services
@inject IAuthApiService AuthApiService
@inject NavigationManager NavigationManager

<PageTitle>회원가입</PageTitle>

<h1>회원가입</h1>

<EditForm Model="registerRequest" OnValidSubmit="RegisterAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">아이디</label>
        <InputText class="form-control"
                   @bind-Value="registerRequest.Username" />
        <ValidationMessage For="@(() => registerRequest.Username)" />
    </div>

    <div class="mb-3">
        <label class="form-label">비밀번호</label>
        <InputText class="form-control"
                   type="password"
                   @bind-Value="registerRequest.Password" />
        <ValidationMessage For="@(() => registerRequest.Password)" />
    </div>

    <div class="mb-3">
        <label class="form-label">닉네임</label>
        <InputText class="form-control"
                   @bind-Value="registerRequest.Nickname" />
        <ValidationMessage For="@(() => registerRequest.Nickname)" />
    </div>

    <button class="btn btn-primary"
            type="submit"
            disabled="@isSubmitting">
        @(isSubmitting ? "처리 중..." : "회원가입")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success mt-3">
        @successMessage
    </div>
}

@code {
    private readonly RegisterRequest registerRequest = new();
    private bool isSubmitting;
    private string errorMessage = "";
    private string successMessage = "";

    private async Task RegisterAsync()
    {
        isSubmitting = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            RegisterResponse response =
                await AuthApiService.RegisterAsync(registerRequest);

            successMessage =
                $"{response.Nickname}님의 회원가입이 완료되었습니다.";

            registerRequest.Username = "";
            registerRequest.Password = "";
            registerRequest.Nickname = "";

            await Task.Delay(1000);

            // NavigationManager.NavigateTo("/login");
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}