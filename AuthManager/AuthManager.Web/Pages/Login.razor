@page "/login"
@using AuthManager.Web.Models
@using AuthManager.Web.Services
@inject IAuthApiService AuthApiService
@inject ITokenStorageService TokenStorageService
@inject JwtAuthenticationStateProvider AuthenticationStateProvider

<PageTitle>로그인</PageTitle>

<h1>로그인</h1>

<EditForm Model="loginRequest" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">아이디</label>
        <InputText class="form-control"
                   @bind-Value="loginRequest.Username" />
        <ValidationMessage For="@(() => loginRequest.Username)" />
    </div>

    <div class="mb-3">
        <label class="form-label">비밀번호</label>
        <InputText class="form-control"
                   type="password"
                   @bind-Value="loginRequest.Password" />
        <ValidationMessage For="@(() => loginRequest.Password)" />
    </div>

    <button class="btn btn-primary"
            type="submit"
            disabled="@isSubmitting">
        @(isSubmitting ? "로그인 중..." : "로그인")
    </button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@if (loginResponse != null)
{
    <div class="alert alert-success mt-3">
        <div>로그인에 성공했습니다.</div>
        <div>아이디: @loginResponse.Username</div>
        <div>닉네임: @loginResponse.Nickname</div>
        <div>권한: @loginResponse.Role</div>
        <div>만료 시각: @loginResponse.ExpiresAt.ToLocalTime()</div>
    </div>
}

@code {
    private readonly LoginRequest loginRequest = new();
    private LoginResponse? loginResponse;
    private bool isSubmitting;
    private string errorMessage = "";

    private async Task LoginAsync()
    {
        isSubmitting = true;
        errorMessage = "";
        loginResponse = null;

        try
        {
            loginResponse =
                await AuthApiService.LoginAsync(loginRequest);

            await TokenStorageService.SaveTokensAsync(
                loginResponse.AccessToken,
                loginResponse.RefreshToken);

            AuthenticationStateProvider
                .NotifyUserAuthentication(
                    loginResponse.AccessToken);
        }
        catch (Exception exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}