<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DevDesk.App.MainWindow" Title="DevDesk" Width="1200" Height="750" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F3F4F6">

    <Window.Resources>
        <Style x:Key="GenericPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="프로세스 관리">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="서버 상태 검사">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="로그 감시">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="이력 조회">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="설정">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="프로세스 관리">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="HttpPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="서버 상태 검사">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="로그 감시">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="이력 조회">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsPageStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentPageTitle}" Value="설정">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2937">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Margin="20,24,20,8" Foreground="White" FontSize="26" FontWeight="Bold" Text="DevDesk"/>

                    <TextBlock Margin="20,0,20,24" Foreground="#9CA3AF" FontSize="12" Text="Developer Management Tool"/>

                    <Button Margin="12,4" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowDashboardCommand}" Content="대시보드"/>

                    <Button Margin="12,4" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowProcessesCommand}" Content="프로세스 관리"/>

                    <Button Margin="12,4" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowServerMonitorCommand}" Content="서버 상태 검사"/>

                    <Button Margin="12,4" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowLogMonitorCommand}" Content="로그 감시"/>

                    <Button Margin="12,4" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowHistoryCommand}" Content="이력 조회"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Margin="12,4,12,16" Height="42" Padding="16,0" HorizontalContentAlignment="Left" Command="{Binding ShowSettingsCommand}" Content="설정"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <TextBlock Margin="24,0" VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding CurrentPageTitle}"/>
            </Border>

            <Grid Grid.Row="1" Margin="24">
                <Border Padding="24" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid Style="{StaticResource GenericPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="대시보드" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="DevDesk의 현재 상태를 한눈에 확인합니다." Style="{StaticResource DescriptionTextStyle}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280" Text="프로세스 수"/>

                                        <TextBlock Margin="0,8,0,0" FontSize="24" FontWeight="Bold" Text="{Binding DashboardProcessCount}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280" Text="HTTP 상태"/>

                                        <TextBlock Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Text="{Binding DashboardHttpStatus}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280" Text="TCP 상태"/>

                                        <TextBlock Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Text="{Binding DashboardTcpStatus}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280" Text="서버 감시"/>

                                        <TextBlock Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Text="{Binding DashboardMonitoringStatus}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="8" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="#6B7280" Text="로그 감시"/>

                                        <TextBlock Margin="0,8,0,0" FontSize="20" FontWeight="Bold" Text="{Binding DashboardLogStatus}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Padding="16" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,0,0,14" FontSize="18" FontWeight="SemiBold" Text="최근 검사 이력"/>

                                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentHistories}" Style="{StaticResource StandardDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="80" Header="유형" Binding="{Binding CheckType}"/>

                                            <DataGridTextColumn Width="*" Header="대상" Binding="{Binding Target}"/>

                                            <DataGridTextColumn Width="90" Header="결과" Binding="{Binding StatusText}"/>

                                            <DataGridTextColumn Width="100" Header="응답(ms)" Binding="{Binding ResponseTimeMs}"/>

                                            <DataGridTextColumn Width="160" Header="검사 시각" Binding="{Binding CheckedAtText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Style="{StaticResource ProcessPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Width="110" Margin="0,0,8,0" Command="{Binding RefreshProcessesCommand}" Content="새로고침" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Width="110" Command="{Binding KillProcessCommand}" Content="프로세스 종료" Style="{StaticResource DangerButtonStyle}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="실행 중인 프로세스" Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Margin="0,4,0,0" Text="현재 Windows에서 실행 중인 프로세스를 조회합니다." Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,0,0,16" Padding="12" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding ProcessFilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding BrowseProcessCommand}" Content="찾아보기" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="2" Command="{Binding StartProcessCommand}" Content="실행" Style="{StaticResource PrimaryButtonStyle}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Margin="0,0,0,16" Padding="12" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="프로세스 검색"/>

                                    <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding ProcessSearchText,                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <Button Grid.Column="2" Command="{Binding ClearProcessSearchCommand}" Content="검색 초기화" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="3" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Style="{StaticResource StandardDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="90" Header="PID" Binding="{Binding Id}"/>

                                    <DataGridTextColumn Width="*" Header="프로세스 이름" Binding="{Binding Name}"/>

                                    <DataGridTextColumn Width="130" Header="메모리(MB)" Binding="{Binding MemoryMb}"/>

                                    <DataGridTextColumn Width="170" Header="시작 시간" Binding="{Binding StartTime}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Style="{StaticResource HttpPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="서버 상태 검사" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="HTTP 응답과 TCP 포트 연결 상태를 확인합니다." Style="{StaticResource DescriptionTextStyle}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Margin="0,0,0,20" Padding="14" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="자동 감시 주기(초)"/>

                                    <TextBox Grid.Column="1" Margin="0,0,10,0" Text="{Binding MonitorIntervalSeconds,                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <Button Grid.Column="2" Margin="0,0,8,0" Command="{Binding StartMonitoringCommand}" Content="감시 시작" Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button Grid.Column="3" Command="{Binding StopMonitoringCommand}" Content="감시 중지" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <TextBlock Grid.Column="4" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding MonitoringStatusText}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- HTTP 검사 -->
                                <Border Grid.Column="0" Padding="20" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="HTTP 상태 검사"/>

                                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" Text="URL로 요청을 보내 응답 상태를 확인합니다."/>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Margin="0,0,10,0" Text="{Binding HttpUrl,                                             UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                            <Button Grid.Column="1" Command="{Binding CheckHttpCommand}" Content="상태 검사" Style="{StaticResource PrimaryButtonStyle}"/>
                                        </Grid>

                                        <Border Grid.Row="2" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding HttpCheckResult.StatusText,                                                   TargetNullValue=검사 결과 없음}"/>

                                                <TextBlock Margin="0,16,0,0" Text="{Binding HttpCheckResult.Url,                                                   StringFormat=주소: {0},                                                   TargetNullValue=주소: -}"/>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding HttpCheckResult.StatusCodeText,                                                   StringFormat=HTTP 상태 코드: {0},                                                   TargetNullValue=HTTP 상태 코드: -}"/>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding HttpCheckResult.ResponseTimeMs,                                                   StringFormat=응답 시간: {0} ms,                                                   TargetNullValue=응답 시간: -}"/>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding HttpCheckResult.CheckedAtText,                                                   StringFormat=검사 시각: {0},                                                   TargetNullValue=검사 시각: -}"/>

                                                <TextBlock Margin="0,12,0,0" Foreground="#6B7280" Text="{Binding HttpCheckResult.Message,                                                   TargetNullValue=HTTP 상태 검사를 실행하세요.}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- TCP 검사 -->
                                <Border Grid.Column="2" Padding="20" Style="{StaticResource CardBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="TCP 포트 검사"/>

                                            <TextBlock Margin="0,4,0,0" Foreground="#6B7280" Text="호스트와 포트에 TCP 연결을 시도합니다."/>
                                        </StackPanel>

                                        <Grid Grid.Row="1" Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding TcpHost,                                             UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                            <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding TcpPort,                                             UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                            <Button Grid.Column="2" Command="{Binding CheckTcpCommand}" Content="연결 검사" Style="{StaticResource PrimaryButtonStyle}"/>
                                        </Grid>

                                        <Border Grid.Row="2" Padding="16" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding TcpCheckResult.StatusText,                                                   TargetNullValue=검사 결과 없음}"/>

                                                <TextBlock Margin="0,16,0,0" Text="{Binding TcpCheckResult.TargetText,                                                   StringFormat=대상: {0},                                                   TargetNullValue=대상: -}"/>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding TcpCheckResult.ResponseTimeMs,                                                   StringFormat=응답 시간: {0} ms,                                                   TargetNullValue=응답 시간: -}"/>

                                                <TextBlock Margin="0,8,0,0" Text="{Binding TcpCheckResult.CheckedAtText,                                                   StringFormat=검사 시각: {0},                                                   TargetNullValue=검사 시각: -}"/>

                                                <TextBlock Margin="0,12,0,0" Foreground="#6B7280" Text="{Binding TcpCheckResult.Message,                                                   TargetNullValue=TCP 포트 검사를 실행하세요.}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid Style="{StaticResource LogPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding LogWatchingStatusText}"/>

                                <StackPanel>
                                    <TextBlock Text="로그 파일 실시간 감시" Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Margin="0,4,0,0" Text="선택한 로그 파일에 추가되는 내용을 실시간으로 표시합니다." Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                            </DockPanel>

                            <Border Grid.Row="1" Margin="0,0,0,16" Padding="14" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding LogFilePath,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding BrowseLogFileCommand}" Content="찾아보기" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="2" Margin="0,0,8,0" Command="{Binding StartLogWatchingCommand}" Content="감시 시작" Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Button Grid.Column="3" Margin="0,0,8,0" Command="{Binding StopLogWatchingCommand}" Content="감시 중지" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="4" Command="{Binding ClearLogsCommand}" Content="화면 초기화" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Margin="0,0,0,16" Padding="12" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="로그 검색"/>

                                    <TextBox Grid.Column="1" Margin="0,0,8,0" Text="{Binding LogSearchText,                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <Button Grid.Column="2" Margin="0,0,20,0" Command="{Binding ClearLogSearchCommand}" Content="검색 초기화" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <TextBlock Grid.Column="3" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="최대 줄 수"/>

                                    <TextBox Grid.Column="4" Text="{Binding MaxLogLinesText,                                 UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="LogDataGrid" Grid.Row="3" ItemsSource="{Binding LogEntriesView}" Style="{StaticResource StandardDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="100" Header="감지 시각" Binding="{Binding DetectedAtText}"/>

                                    <DataGridTextColumn Width="*" Header="로그 내용" Binding="{Binding Content}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid Style="{StaticResource HistoryPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="검사 이력 조회" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="SQLite에 저장된 HTTP·TCP 검사 결과를 조회합니다." Style="{StaticResource DescriptionTextStyle}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Margin="0,0,0,16" Padding="12" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="검사 유형"/>

                                    <ComboBox Grid.Column="1" Height="34" VerticalContentAlignment="Center" ItemsSource="{Binding HistoryTypeFilters}" SelectedItem="{Binding HistoryTypeFilter}"/>

                                    <Button Grid.Column="3" Margin="0,0,8,0" Command="{Binding RefreshHistoriesCommand}" Content="새로고침" Style="{StaticResource SecondaryButtonStyle}"/>

                                    <Button Grid.Column="4" Command="{Binding DeleteAllHistoriesCommand}" Content="전체 삭제" Style="{StaticResource DangerButtonStyle}"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2" ItemsSource="{Binding CheckHistoriesView}" SelectedItem="{Binding SelectedHistory}" Style="{StaticResource StandardDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="70" Header="번호" Binding="{Binding Id}"/>

                                    <DataGridTextColumn Width="75" Header="유형" Binding="{Binding CheckType}"/>

                                    <DataGridTextColumn Width="*" Header="대상" Binding="{Binding Target}"/>

                                    <DataGridTextColumn Width="80" Header="결과" Binding="{Binding StatusText}"/>

                                    <DataGridTextColumn Width="90" Header="상태 코드" Binding="{Binding StatusCodeText}"/>

                                    <DataGridTextColumn Width="95" Header="응답(ms)" Binding="{Binding ResponseTimeMs}"/>

                                    <DataGridTextColumn Width="155" Header="검사 시각" Binding="{Binding CheckedAtText}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Margin="0,16,0,0" Padding="12" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <TextBlock Foreground="#6B7280" Text="{Binding SelectedHistory.Message,                                   TargetNullValue=이력을 선택하면 상세 메시지가 표시됩니다.}" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>

                        <Grid Style="{StaticResource SettingsPageStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="설정" Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="DevDesk에서 사용하는 기본 입력값을 저장합니다." Style="{StaticResource DescriptionTextStyle}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Padding="24" Background="#F9FAFB" Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="기본 HTTP 주소"/>

                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,14" Text="{Binding HttpUrl,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="기본 TCP 호스트"/>

                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14" Text="{Binding TcpHost,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="기본 TCP 포트"/>

                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,14" Text="{Binding TcpPort,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="자동 감시 주기(초)"/>

                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,14" Text="{Binding MonitorIntervalSeconds,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="기본 로그 파일 경로"/>

                                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,14" Text="{Binding LogFilePath,                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,16,14" VerticalAlignment="Center" FontWeight="SemiBold" Text="최대 로그 줄 수"/>

                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,14" Text="{Binding MaxLogLinesText,                         UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="서버 상태 알림"/>

                                    <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding EnableStatusNotifications}" Content="HTTP·TCP 장애 및 복구 알림 사용" Style="{StaticResource StandardCheckBoxStyle}"/>
                                </Grid>
                            </Border>

                            <Button Grid.Row="2" Width="120" Margin="0,16,0,0" HorizontalAlignment="Right" Command="{Binding SaveSettingsCommand}" Content="설정 저장" Style="{StaticResource PrimaryButtonStyle}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12" Text="{Binding StatusMessage}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
